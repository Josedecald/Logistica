extends Resource
class_name Incidente

enum Categoria {
	# Económicos / poder
	CORRUPCION, SOBORNO, FRAUDE, MALVERSACION_FONDOS, EVASION_IMPUESTOS,
	EXTORSION, TRAFICO_INFLUENCIAS, LAVADO_DINERO,

	# Violentos / graves
	HOMICIDIO, SECUESTRO, VIOLENCIA_DOMESTICA, NARCOTRAFICO,

	# Abuso de posición
	ABUSO_PODER, NEGLIGENCIA_MEDICA, ENCUBRIMIENTO, EXPLOTACION_LABORAL, ABUSO_AUTORIDAD_RELIGIOSA,

	# Menores / oportunidad
	ROBO, ESTAFA_MENOR, DIFAMACION, DISCRIMINACION,

	# Positivos
	DONACIONES, RESCATE_PERSONAS, TRABAJO_COMUNITARIO, DENUNCIA_CORRUPCION,
	ADOPCION_ACOGIDA, INNOVACION_BENEFICIOSA, DEFENSA_DERECHOS_HUMANOS,
	SACRIFICIO_PERSONAL, MENTORIA_EDUCACION
}

@export var categoria: Categoria
@export var texto: String
@export var cantidad_registros: int = 1
